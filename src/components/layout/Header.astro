---
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { siteContent } from '@data/site.content';

const { brand, nav } = siteContent;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={brand.homeHref} class="brand" aria-label={`${brand.name} — Inicio`}>
      <span class="brand__mark" aria-hidden="true">
        <Icon name={brand.icon} size={18} strokeWidth={2} />
      </span>
      <span class="brand__name">{brand.name}</span>
    </a>

    <nav class="nav" aria-label="Principal">
      <ul role="list">
        {nav.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <Button href={nav.cta.href} variant="primary" size="sm" iconAfter="arrow-right">
        {nav.cta.label}
      </Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 1rem;
    inset-inline: 0;
    margin-inline: auto;
    max-width: var(--container-max);
    height: 48px;
    z-index: 100;
    padding-inline: 0.5rem;
  }

  @media (min-width: 768px) {
    .site-header {
      padding-inline: 3rem;
    }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
    padding: 0 0.5rem 0 1rem;
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-strong);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--brand-500);
    color: #fff;
    box-shadow: 0 4px 14px var(--brand-glow);
  }

  .brand__name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 33px;
    padding: 0 1rem;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--fg-muted);
    border-radius: var(--radius-sm);
    transition: color 160ms var(--ease-out);
  }

  .nav a:hover {
    color: var(--fg-strong);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 880px) {
    .nav {
      display: none;
    }
  }
</style>
