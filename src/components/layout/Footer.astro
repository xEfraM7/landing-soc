---
import Container from '@components/ui/Container.astro';
import Icon from '@components/ui/Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="grid">
      <div class="brand-block">
        <div class="brand">
          <span class="brand__mark" aria-hidden="true">
            <Icon name="shield" size={18} strokeWidth={1.75} />
          </span>
          <span class="brand__name">
            <span class="brand__name-main">SOC</span><span class="brand__name-sub">Unified</span>
          </span>
        </div>
        <p class="tagline">
          La consola operativa para SOC modernos. Detección, investigación y respuesta — en un solo
          panel.
        </p>
      </div>

      <nav class="col" aria-label="Producto">
        <h4>Producto</h4>
        <ul role="list">
          <li><a href="#platform">Plataforma</a></li>
          <li><a href="#how-it-works">Cómo funciona</a></li>
          <li><a href="#differentiators">Por qué nosotros</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </nav>

      <nav class="col" aria-label="Compañía">
        <h4>Compañía</h4>
        <ul role="list">
          <li><a href="#cta">Pregunta por nuestros servicios</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="mailto:hello@ventech.local">Contacto</a></li>
        </ul>
      </nav>

      <nav class="col" aria-label="Legal">
        <h4>Legal</h4>
        <ul role="list">
          <li><a href="#privacy">Privacidad</a></li>
          <li><a href="#terms">Términos</a></li>
          <li><a href="#security">Seguridad</a></li>
        </ul>
      </nav>
    </div>

    <div class="bottom">
      <p class="copy">&copy; {year} VenTech — Todos los derechos reservados.</p>
      <p class="status">
        <span class="live-dot" aria-hidden="true"></span>
        <span class="text-mono">All systems operational</span>
      </p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--border);
    background: linear-gradient(180deg, transparent, rgba(10, 14, 26, 0.6));
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-block {
      grid-column: 1 / -1;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg-strong);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--brand-500), var(--brand-700));
    color: #fff;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .brand__name-main {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .brand__name-sub {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--fg-default);
    margin-left: 0.2rem;
  }

  .tagline {
    margin-top: 1rem;
    color: var(--fg-muted);
    max-width: 38ch;
    font-size: 0.9rem;
  }

  .col h4 {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    margin-bottom: 1rem;
    font-family: var(--font-mono);
  }

  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col a {
    color: var(--fg-default);
    font-size: 0.9rem;
  }

  .col a:hover {
    color: var(--fg-strong);
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copy {
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--sev-ok);
  }
</style>
