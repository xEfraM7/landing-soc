---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { siteContent } from '@data/site.content';

const { brand, footer } = siteContent;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="grid">
      <div class="brand-block">
        <a href={brand.homeHref} class="brand" aria-label={`${brand.name} — Inicio`}>
          <span class="brand__mark" aria-hidden="true">
            <Icon name={brand.icon} size={20} strokeWidth={2} />
          </span>
          <span class="brand__name">{brand.name}</span>
        </a>
        <p class="tagline">{footer.tagline}</p>
        <Button href={footer.cta.href} variant="primary" size="md" iconAfter="arrow-right">
          {footer.cta.label}
        </Button>
      </div>

      {footer.columns.map((column) => (
        <nav class="col" aria-label={column.heading}>
          <h4>{column.heading}</h4>
          <ul role="list">
            {column.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="copy">&copy; {year} {footer.copyright}</p>
  </Container>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3rem;
    padding-block: 2rem 3rem;
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand-block {
      grid-column: 1 / -1;
    }
  }

  .brand-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg-strong);
    font-weight: 600;
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--brand-500);
    color: #fff;
    box-shadow: 0 4px 14px var(--brand-glow);
  }

  .brand__name {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  .tagline {
    color: var(--fg-muted);
    max-width: 30ch;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .col h4 {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-strong);
    margin-bottom: 1rem;
  }

  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col a {
    color: var(--fg-muted);
    font-size: 0.9rem;
    transition: color 160ms var(--ease-out);
  }

  .col a:hover {
    color: var(--fg-strong);
  }

  .copy {
    color: var(--fg-muted);
    font-size: 0.85rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
