---
import Icon from '@components/ui/Icon.astro';
import type { IconName } from '@assets/icons';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  iconAfter?: IconName;
  iconBefore?: IconName;
  type?: 'button' | 'submit';
  class?: string;
  target?: string;
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  iconAfter,
  iconBefore,
  type = 'button',
  class: className,
  target,
  rel,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const extraProps = href
  ? { href, target, rel: rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined) }
  : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...extraProps}>
  {iconBefore && <Icon name={iconBefore} size={size === 'lg' ? 18 : 16} />}
  <span class="btn__label"><slot /></span>
  {iconAfter && <Icon name={iconAfter} size={size === 'lg' ? 18 : 16} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    user-select: none;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      transform 160ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      color 200ms var(--ease-out);
  }

  .btn--sm {
    height: 36px;
    padding: 0 0.875rem;
    font-size: 0.8125rem;
  }

  .btn--md {
    height: 40px;
    padding: 0 2rem;
    font-size: 0.875rem;
  }

  .btn--lg {
    height: 44px;
    padding: 0 2rem;
    font-size: 0.9375rem;
  }

  .btn:active {
    transform: translateY(1px);
  }

  /* Primary — solid red-coral (#ff3241), matches repteam CTA */
  .btn--primary {
    background: var(--brand-500);
    color: #ededed;
  }

  .btn--primary:hover {
    background: var(--brand-600);
  }

  /* Secondary — zinc-950 with subtle border */
  .btn--secondary {
    background: var(--bg-base);
    color: var(--fg-strong);
    border-color: var(--bg-elev-2);
  }

  .btn--secondary:hover {
    background: var(--bg-elev-1);
    border-color: var(--bg-elev-3);
  }

  /* Ghost — no border/bg until hover */
  .btn--ghost {
    background: transparent;
    color: var(--fg-default);
  }

  .btn--ghost:hover {
    background: var(--bg-elev-1);
    color: var(--fg-strong);
  }

  .btn__label {
    display: inline-flex;
  }
</style>
