---
import Container from '@components/ui/Container.astro';
import { siteContent } from '@data/site.content';

const { eyebrow, heading, about, members } = siteContent.team;
---

<section id="equipo" class="team" aria-labelledby="team-title">
  <Container>
    <header class="team__head">
      <span class="eyebrow-pill">
        <span class="eyebrow-pill__dot"></span>
        {eyebrow}
      </span>
      <h2 id="team-title" class="team__title">
        <span class="text-gradient">{heading}</span>
      </h2>
    </header>

    <div class="team__about">
      <h3 class="team__about-title">{about.heading}</h3>
      <div class="team__about-body">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ul class="team__grid" role="list">
      {members.map((member) => (
        <li class="member">
          <div class="member__photo-wrap">
            <img
              class="member__photo"
              src={member.photo}
              alt={`Foto de ${member.name}`}
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="member__name">{member.name}</span>
          <span class="member__role">{member.role}</span>
          <p class="member__bio">{member.bio}</p>
          <a
            class="member__linkedin"
            href={member.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Perfil de LinkedIn de ${member.name}`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .team {
    padding-block: var(--section-pad-y);
  }

  .team__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 720px;
    margin-inline: auto;
  }

  .team__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .team__about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 820px;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  @media (min-width: 760px) {
    .team__about {
      grid-template-columns: 0.7fr 1.3fr;
      gap: 2.5rem;
      text-align: left;
      align-items: start;
    }
  }

  .team__about-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--fg-strong);
  }

  .team__about-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .team__about-body p {
    color: var(--fg-default);
    font-size: 1rem;
    line-height: 1.65;
  }

  .team__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin: 3rem auto 0;
    padding: 0;
    list-style: none;
    max-width: 760px;
  }

  @media (min-width: 560px) {
    .team__grid { grid-template-columns: 1fr 1fr; }
  }

  .member {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 2rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      background 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .member:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
  }

  .member__photo-wrap {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border-strong);
    margin-bottom: 0.75rem;
    flex-shrink: 0;
  }

  .member__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .member__name {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--fg-strong);
  }

  .member__role {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.1rem;
  }

  .member__bio {
    font-size: 0.875rem;
    color: var(--fg-muted);
    line-height: 1.6;
    margin: 0.75rem 0 0;
  }

  .member__linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg-subtle);
    text-decoration: none;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  .member__linkedin:hover {
    color: var(--fg-strong);
    border-color: var(--border-strong);
  }
</style>
