---
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Badge from '@components/ui/Badge.astro';
import Icon from '@components/ui/Icon.astro';
---

<section id="top" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid" data-speed="0.85"></div>
    <div class="hero__glow hero__glow--a" data-speed="0.5"></div>
    <div class="hero__glow hero__glow--b" data-speed="0.7"></div>
  </div>

  <Container>
    <div class="hero__copy">
      <div class="hero__tag reveal" style="--reveal-delay: 0ms">
        <Badge tone="brand" mono withDot pulse>
          v1 — Detect · Investigate · Respond
        </Badge>
      </div>

      <h1 class="hero__title reveal" style="--reveal-delay: 80ms">
        Tu Centro de Operaciones de Seguridad,<br />
        <em>unificado</em> y en tiempo real.
      </h1>

      <p class="hero__lead reveal" style="--reveal-delay: 160ms">
        Centraliza toda tu seguridad en un solo panel: detecta,
        investiga y responde a amenazas con mapeo MITRE ATT&amp;CK, respuesta activa y
        aislamiento por organización para MSSPs y equipos de seguridad.
      </p>

      <div class="hero__cta reveal" style="--reveal-delay: 240ms">
        <Button href="#cta" variant="primary" size="lg" iconAfter="arrow-right">
          Pregunta por nuestros servicios
        </Button>
        <Button href="#how-it-works" variant="secondary" size="lg">
          Ver cómo funciona
        </Button>
      </div>

      <ul class="hero__trust reveal" style="--reveal-delay: 320ms" role="list">
        <li>
          <Icon name="check" size={16} />
          <span>Multi-tenant real</span>
        </li>
        <li>
          <Icon name="check" size={16} />
          <span>RBAC granular</span>
        </li>
        <li>
          <Icon name="check" size={16} />
          <span>Auditoría inmutable</span>
        </li>
      </ul>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(6rem, 12vw, 10rem) clamp(5rem, 10vw, 8rem);
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }

  /* Background ornamentation */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(148, 163, 209, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(148, 163, 209, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black, transparent 70%);
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .hero__glow--a {
    width: 560px;
    height: 560px;
    top: -220px;
    left: 50%;
    transform: translateX(-65%);
    background: radial-gradient(circle, rgba(59, 130, 246, 0.5), transparent 60%);
  }
  .hero__glow--b {
    width: 520px;
    height: 520px;
    top: 30%;
    left: 50%;
    transform: translateX(-30%);
    background: radial-gradient(circle, rgba(34, 211, 238, 0.32), transparent 60%);
    opacity: 0.45;
  }

  /* Single-column centered layout */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 820px;
    margin-inline: auto;
  }

  .hero__title {
    font-size: clamp(2.6rem, 6.2vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--fg-strong);
  }

  .hero__title em {
    font-style: italic;
    color: transparent;
    background: linear-gradient(135deg, var(--brand-300) 0%, var(--accent-cyan) 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero__lead {
    color: var(--fg-default);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    max-width: 60ch;
  }

  .hero__lead strong {
    color: var(--fg-strong);
    font-weight: 600;
  }

  .hero__cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .hero__trust {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 2rem;
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .hero__trust :global(svg) {
    color: var(--sev-ok);
  }
</style>
