---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { steps } from './how-it-works.data';
---

<section id="how-it-works" class="how" aria-labelledby="how-title">
  <Container>
    <SectionHeading
      eyebrow="Cómo funciona"
      title="De la alerta a la contención, en <em>cuatro pasos</em>."
      lead="Un flujo continuo: ingesta, detección, investigación y respuesta. Sin cambiar de pestaña."
      id="how-title"
    />

    <ol class="steps" role="list">
      {steps.map((s, idx) => (
        <li class="step">
          <div class="step__rail" aria-hidden="true">
            <span class="step__rail-dot"></span>
            {idx < steps.length - 1 && <span class="step__rail-line"></span>}
          </div>
          <div class="step__head">
            <span class="step__num text-mono">{s.num}</span>
            <span class="step__icon" aria-hidden="true">
              <Icon name={s.icon} size={20} />
            </span>
          </div>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__desc">{s.description}</p>
          <span class="step__detail text-mono">{s.detail}</span>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .how {
    padding-block: var(--section-pad-y);
    border-top: 1px solid var(--border);
  }

  .steps {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem;
    background: var(--bg-elev-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 220ms var(--ease-out), background 220ms var(--ease-out);
  }

  .step:hover {
    border-color: var(--border-strong);
    background: var(--bg-elev-2);
  }

  .step__rail {
    position: absolute;
    top: 1.4rem;
    right: -0.75rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    z-index: 1;
  }

  @media (max-width: 960px) {
    .step__rail {
      display: none;
    }
  }

  .step__rail-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 1px solid var(--brand-500);
  }

  .step__rail-line {
    width: 1rem;
    height: 1px;
    background: linear-gradient(90deg, var(--brand-500), transparent);
  }

  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step__num {
    font-size: 0.75rem;
    color: var(--brand-300);
    letter-spacing: 0.14em;
    font-weight: 500;
  }

  .step__icon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, var(--bg-elev-2), var(--bg-elev-3));
    color: var(--brand-300);
    border: 1px solid var(--border-strong);
  }

  .step__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.35rem;
    line-height: 1.15;
    color: var(--fg-strong);
    letter-spacing: -0.01em;
  }

  .step__desc {
    font-size: 0.9rem;
    color: var(--fg-muted);
    line-height: 1.55;
  }

  .step__detail {
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border);
    font-size: 0.7rem;
    color: var(--fg-faint);
    letter-spacing: 0.05em;
  }
</style>
