---
import Container from '@components/ui/Container.astro';
import Icon from '@components/ui/Icon.astro';
import { siteContent } from '@data/site.content';

const { problem, solution } = siteContent;
---

<section id="problema" class="problem" aria-labelledby="problem-title">
  <Container>
    <div class="problem__inner">
      <div class="problem__head">
        <span class="eyebrow-pill">
          <span class="eyebrow-pill__dot"></span>
          {problem.eyebrow}
        </span>
        <h2 id="problem-title" class="problem__title">
          <span class="problem__icon" aria-hidden="true"><Icon name="alert" size={28} /></span>
          {problem.heading}
        </h2>
      </div>
      <div class="problem__body">
        {problem.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </Container>
</section>

<section id="solucion" class="solution" aria-labelledby="solution-title">
  <div class="solution__bg" aria-hidden="true">
    <div class="solution__glow"></div>
  </div>

  <Container>
    <header class="solution__head">
      <span class="eyebrow-pill">
        <span class="eyebrow-pill__dot"></span>
        {solution.eyebrow}
      </span>
      <h2 id="solution-title" class="solution__title">
        <span class="text-gradient">{solution.heading}</span>
      </h2>
      <p class="solution__lead">{solution.lead}</p>
    </header>

    <div class="solution__body">
      {solution.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <ul class="solution__pillars" role="list">
      {solution.pillars.map((pillar) => (
        <li class="pillar">
          <div class="pillar__icon" aria-hidden="true">
            <span class="pillar__glow"></span>
            <Icon name={pillar.icon} size={22} />
          </div>
          <h3 class="pillar__title">{pillar.title}</h3>
          <p class="pillar__body">{pillar.body}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>

<style>
  /* ---------------- El Problema ---------------- */
  .problem {
    padding-block: var(--section-pad-y);
  }

  .problem__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand-500);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 900px) {
    .problem__inner {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
      align-items: start;
    }
  }

  .problem__head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .problem__title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .problem__icon {
    display: grid;
    place-items: center;
    color: var(--brand-500);
  }

  .problem__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .problem__body p {
    color: var(--fg-default);
    font-size: clamp(1rem, 1.4vw, 1.0625rem);
    line-height: 1.65;
  }

  /* ---------------- Nuestra Solución ---------------- */
  .solution {
    position: relative;
    padding-block: var(--section-pad-y);
    overflow: hidden;
    isolation: isolate;
  }

  .solution__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .solution__glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 620px;
    height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--brand-glow-soft), transparent 65%);
    filter: blur(80px);
    contain: strict;
  }

  .solution__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 760px;
    margin-inline: auto;
  }

  .solution__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .solution__lead {
    color: var(--fg-strong);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    max-width: 44rem;
  }

  .solution__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 800px;
    margin: 2rem auto 0;
    text-align: center;
  }

  @media (min-width: 760px) {
    .solution__body {
      grid-template-columns: 1fr 1fr;
      text-align: left;
    }
  }

  .solution__body p {
    color: var(--fg-default);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .solution__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .solution__pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition:
      background 300ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .pillar:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-strong);
  }

  .pillar__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--brand-500);
  }

  .pillar__glow {
    position: absolute;
    inset: 0;
    background: var(--brand-glow-soft);
    border-radius: 50%;
    filter: blur(18px);
    z-index: -1;
  }

  .pillar__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--fg-strong);
  }

  .pillar__body {
    color: var(--fg-default);
    font-size: 0.9rem;
    line-height: 1.6;
  }
</style>
