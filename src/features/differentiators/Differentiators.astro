---
import Container from '@components/ui/Container.astro';
import { useSiteContent } from '@utils/i18n';

const { content } = useSiteContent(Astro);
const { eyebrow, heading, lead, items } = content.differentiators;
---

<section id="diferenciadores" class="diff" aria-labelledby="diff-title">
  <Container>
    <header class="diff__head">
      <span class="eyebrow-pill">
        <span class="eyebrow-pill__dot"></span>
        {eyebrow}
      </span>
      <h2 id="diff-title" class="diff__title">
        <span class="text-gradient">{heading}</span>
      </h2>
      <p class="diff__lead">{lead}</p>
    </header>

    <div class="diff__grid">
      {items.map((item) => (
        <article class="row">
          <span class="row__number" aria-hidden="true">{item.number}</span>
          <h3 class="row__title">{item.title}</h3>
          <p class="row__desc">{item.body}</p>
          <span class="row__overlay" aria-hidden="true"></span>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .diff {
    padding-block: var(--section-pad-y);
  }

  .diff__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
    max-width: 720px;
    margin-inline: auto;
  }

  .diff__title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .diff__lead {
    color: var(--fg-default);
    font-size: 1rem;
    line-height: 1.6;
    max-width: 36rem;
  }

  /* Border-grid: cards carry borders so they form a continuous divided grid */
  .diff__grid {
    display: grid;
    grid-template-columns: 1fr;
    margin-top: 3rem;
  }

  @media (min-width: 720px) {
    .diff__grid { grid-template-columns: 1fr 1fr; }
  }

  @media (min-width: 980px) {
    .diff__grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  .row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2.5rem 1.75rem;
    border: 1px solid transparent;
    border-bottom-color: var(--border-neutral-800);
    overflow: hidden;
    isolation: isolate;
  }

  @media (min-width: 720px) {
    .row { border-right-color: var(--border-neutral-800); }
    .row:nth-child(2n) { border-right-color: transparent; }
  }

  @media (min-width: 980px) {
    .row { border-right-color: var(--border-neutral-800); }
    .row:nth-child(2n) { border-right-color: var(--border-neutral-800); }
    .row:nth-child(3n) { border-right-color: transparent; }
  }

  .row__number {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--brand-500);
    letter-spacing: 0.02em;
  }

  .row__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--fg-strong);
  }

  .row__desc {
    color: var(--fg-default);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .row__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(255, 50, 65, 0.18), transparent 70%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms var(--ease-out);
    z-index: -1;
  }

  .row:hover .row__overlay {
    opacity: 1;
  }
</style>
