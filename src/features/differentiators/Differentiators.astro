---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { differentiators } from './differentiators.data';
---

<section id="differentiators" class="diff" aria-labelledby="diff-title">
  <Container>
    <div class="diff__head">
      <SectionHeading
        eyebrow="Por qué nosotros"
        title="Diferenciadores construidos <em>desde el día uno</em>."
        lead="No son addons. Son decisiones arquitectónicas que vienen de fábrica."
        id="diff-title"
      />
    </div>

    <ol class="grid" role="list">
      {differentiators.map((d) => (
        <li class="row">
          <div class="row__num" aria-hidden="true">
            <span class="num">{d.num}</span>
            <span class="row__icon"><Icon name={d.icon} size={18} /></span>
          </div>
          <div class="row__body">
            <h3 class="row__title">{d.title}</h3>
            <p class="row__desc">{d.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .diff {
    padding-block: var(--section-pad-y);
    border-top: 1px solid var(--border);
  }

  .diff__head {
    margin-bottom: 3rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding: 2rem 1.75rem;
    border-top: 1px solid var(--border);
    border-right: 1px solid var(--border);
    transition: background 220ms var(--ease-out);
  }

  .row:hover {
    background: rgba(15, 21, 36, 0.4);
  }

  /* Remove right border on right-column rows */
  .row:nth-child(2n) {
    border-right: none;
  }

  /* Add bottom border on last row(s) so grid is closed */
  .row:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 720px) {
    .row {
      border-right: none;
    }
    .row:nth-last-child(-n + 2) {
      border-bottom: none;
    }
    .row:last-child {
      border-bottom: 1px solid var(--border);
    }
  }

  .row__num {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 2.25rem;
    line-height: 1;
    color: transparent;
    background: linear-gradient(135deg, var(--brand-400), var(--accent-cyan));
    -webkit-background-clip: text;
    background-clip: text;
  }

  .row__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    background: var(--bg-elev-1);
    border: 1px solid var(--border-strong);
    color: var(--brand-300);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .row__title {
    font-size: 1.15rem;
    color: var(--fg-strong);
    letter-spacing: -0.005em;
  }

  .row__desc {
    color: var(--fg-muted);
    font-size: 0.93rem;
    line-height: 1.6;
    max-width: 52ch;
  }
</style>
