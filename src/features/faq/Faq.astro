---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Icon from '@components/ui/Icon.astro';
import { faqs } from './faq.data';
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <Container>
    <div class="layout">
      <div class="layout__head">
        <SectionHeading
          eyebrow="Preguntas frecuentes"
          title="Las cinco cosas que casi siempre nos preguntan."
          lead="Si no encuentras la tuya, escríbenos. Te responde alguien que ha operado SOCs, no un funnel."
          id="faq-title"
        />
      </div>

      <ol class="list" role="list">
        {faqs.map((f, idx) => (
          <li>
            <details class="item">
              <summary class="item__summary">
                <span class="item__num text-mono">0{idx + 1}</span>
                <span class="item__q">{f.q}</span>
                <span class="item__chev" aria-hidden="true">
                  <Icon name="chevron-down" size={18} />
                </span>
              </summary>
              <div class="item__a">
                <p>{f.a}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</section>

<style>
  .faq {
    padding-block: var(--section-pad-y);
    border-top: 1px solid var(--border);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 880px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border);
  }

  .item {
    border-bottom: 1px solid var(--border);
  }

  .item__summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 0.5rem;
    cursor: pointer;
    list-style: none;
    transition: padding 200ms var(--ease-out);
  }

  .item__summary::-webkit-details-marker {
    display: none;
  }

  .item__num {
    font-size: 0.75rem;
    color: var(--brand-300);
    letter-spacing: 0.12em;
  }

  .item__q {
    font-size: 1rem;
    color: var(--fg-strong);
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .item__chev {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    color: var(--fg-muted);
    transition: transform 240ms var(--ease-out), color 200ms var(--ease-out);
  }

  .item[open] .item__chev {
    transform: rotate(180deg);
    color: var(--brand-300);
  }

  .item[open] .item__summary {
    padding-bottom: 0.75rem;
  }

  .item__a {
    padding: 0 0.5rem 1.5rem 3rem;
    max-width: 70ch;
  }

  .item__a p {
    color: var(--fg-muted);
    line-height: 1.65;
    font-size: 0.95rem;
  }

  /* Smooth open animation using grid-template-rows trick on parent wrapper
     — using <details> we rely on natural reveal; keep CSS minimal */
  @media (prefers-reduced-motion: no-preference) {
    .item__a {
      animation: faq-open 260ms var(--ease-out);
    }
    @keyframes faq-open {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
