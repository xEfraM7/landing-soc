import Faq from '@features/faq/Faq.astro';
import Cta from '@features/cta/Cta.astro';
---

<BaseLayout>
  <Header slot="header" />
  <Hero />
  <Personas />
  <HowItWorks />
  <Differentiators />
  <Faq />
  <Cta />
  <Footer slot="footer" />
</BaseLayout>
